# RSS Configuration
SENTIMENT_RSS_POLL_INTERVAL_SECONDS=30
SENTIMENT_RSS_REQUEST_TIMEOUT_SECONDS=10

# Dedup Cache
SENTIMENT_DEDUP_CACHE_MAX_SIZE=10000

# Sentiment Model
SENTIMENT_MODEL_NAME=lxyuan/distilbert-base-multilingual-cased-sentiments-student
SENTIMENT_PROCESS_POOL_SIZE=2

# DeepSeek (REQUIRED)
SENTIMENT_DEEPSEEK_API_KEY=your-deepseek-api-key-here
SENTIMENT_DEEPSEEK_MODEL=deepseek-chat
SENTIMENT_DEEPSEEK_TEMPERATURE=0.3
SENTIMENT_DEEPSEEK_MAX_TOKENS=2048

# Alert Thresholds
SENTIMENT_DEFAULT_ALERT_THRESHOLD=-0.5

# Server
SENTIMENT_HOST=0.0.0.0
SENTIMENT_PORT=8000

# SMTP (optional, for email notifications)
SENTIMENT_SMTP_HOST=smtp.example.com
SENTIMENT_SMTP_PORT=465
SENTIMENT_SMTP_USER=your-email@example.com
SENTIMENT_SMTP_PASS=your-password
SENTIMENT_SMTP_FROM=your-email@example.com
